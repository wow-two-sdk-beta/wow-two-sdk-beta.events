<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <IsTestProject>true</IsTestProject>
  </PropertyGroup>

  <!--
    Conformance tier — the Events suites (one per broker, shipped in the Testing package) run against every
    implementation: the in-process Module over PostgreSQL (the test principal switched per actor), and the Client
    against the service host in process over PostgreSQL, trusting a fake Identity issuer whose tokens the client sends
    per actor. Both forms need Docker (Testcontainers).
  -->
  <ItemGroup>
    <PackageReference Include="WoW2.Sdk.Beta.Be.Testing.Data" />
    <PackageReference Include="WoW2.Sdk.Beta.Be.Identity.Testing" />
    <PackageReference Include="Microsoft.NET.Test.Sdk" />
    <PackageReference Include="xunit.runner.visualstudio" PrivateAssets="all" />
  </ItemGroup>

  <ItemGroup>
    <ProjectReference Include="..\..\packages\Module\WoW.Two.Sdk.Beta.Be.Events.Module.csproj" />
    <ProjectReference Include="..\..\packages\Client\WoW.Two.Sdk.Beta.Be.Events.Client.csproj" />
    <ProjectReference Include="..\..\packages\Testing\WoW.Two.Sdk.Beta.Be.Events.Testing.csproj" />
    <ProjectReference Include="..\..\service\Events.Api\Events.Api.csproj" />
  </ItemGroup>

  <ItemGroup>
    <Using Include="Xunit" />
  </ItemGroup>

</Project>
