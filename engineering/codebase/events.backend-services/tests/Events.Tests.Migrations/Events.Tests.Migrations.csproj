<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <IsTestProject>true</IsTestProject>
  </PropertyGroup>

  <!--
    Migrations tier, required for every set the deploy's migrate step runs (M53): the module's embedded
    Migrations/NNN/*.sql as the named set `events` over a real PostgreSQL (Docker, Testcontainers) — apply once,
    Apply → Rollback → Apply, the be sdk lint and the idempotency proof (Apply → Apply, Rollback → Rollback, history
    bypassed). No HTTP. Rides the SDK Testing.Data harness (MigratorHarness over the drop-schema MigratorPostgresFixture).
  -->
  <ItemGroup>
    <PackageReference Include="WoW2.Sdk.Beta.Be.Testing.Data" />
    <PackageReference Include="Microsoft.NET.Test.Sdk" />
    <PackageReference Include="xunit" />
    <PackageReference Include="xunit.runner.visualstudio" PrivateAssets="all" />
    <PackageReference Include="AwesomeAssertions" />
  </ItemGroup>

  <ItemGroup>
    <ProjectReference Include="..\..\packages\Module\WoW.Two.Sdk.Beta.Be.Events.Module.csproj" />
  </ItemGroup>

  <ItemGroup>
    <Using Include="Xunit" />
  </ItemGroup>

</Project>
