<Project Sdk="Microsoft.NET.Sdk">

  <!--
    Form 1: the greetings capability in the consumer's process, over the consumer's PostgreSQL database. Ships its schema
    as the named set `events` (schema `events`) of embedded Migrations/NNN-name/{Apply,Rollback}.sql; the host's migrate
    verbs apply it, and a local run's boot.
  -->
  <PropertyGroup>
    <Description>Events Form 1: the in-process greetings module over the consumer's PostgreSQL database, with its SQL migration set.</Description>
  </PropertyGroup>

  <ItemGroup>
    <FrameworkReference Include="Microsoft.AspNetCore.App" />
    <PackageReference Include="WoW2.Sdk.Beta.Be" />
  </ItemGroup>

  <ItemGroup>
    <ProjectReference Include="..\Abstractions\WoW.Two.Sdk.Beta.Be.Events.Abstractions.csproj" />
  </ItemGroup>

  <!-- SQL migrations ship embedded (logical name "Migrations/NNN-name/Apply.sql"), resolved by the SDK migrator. -->
  <ItemGroup>
    <!-- Exclude Dev/ drafts: unpromoted SQL never ships in the package. -->
    <EmbeddedResource Include="Migrations\**\*.sql" Exclude="Migrations\Dev\**\*.sql">
      <LogicalName>Migrations/%(RecursiveDir)%(Filename)%(Extension)</LogicalName>
    </EmbeddedResource>
  </ItemGroup>

  <ItemGroup>
    <InternalsVisibleTo Include="Events.Tests.Unit" />
    <InternalsVisibleTo Include="Events.Tests.Integration" />
    <InternalsVisibleTo Include="Events.Tests.Migrations" />
  </ItemGroup>

</Project>
